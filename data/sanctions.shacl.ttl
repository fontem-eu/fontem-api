# SHACL shapes — sanctions pilot.
#
# Validates SanctionedEntity write-time. Every loader run pipes its
# output Turtle through pyshacl with this shape file before the
# triples land in Virtuoso; failures abort the load and keep the
# graph clean.

@prefix fontem:    <http://data.fontem.eu/ontology#> .
@prefix shape:     <http://data.fontem.eu/shape/> .
@prefix sh:        <http://www.w3.org/ns/shacl#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .

shape:SanctionedEntity
    a sh:NodeShape ;
    sh:targetClass fontem:SanctionedEntity ;
    rdfs:label "SanctionedEntity shape"@en ;

    # Identity — every entity has exactly one EU FSD reference, no
    # collisions allowed.
    sh:property [
        sh:path fontem:euReference ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "SanctionedEntity must carry exactly one fontem:euReference."@en ;
    ] ;

    # Display label — at least one rdfs:label, in any language.
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "SanctionedEntity must have at least one rdfs:label."@en ;
    ] ;

    # Designation date — when present must be a valid xsd:date.
    # Some legacy EU FSD rows are missing it (older listings carry
    # only the regulation citation); enforcing minCount=1 against
    # real data drops ~5% of entries on the floor, which is too
    # strict given we have other ways to date the listing.
    sh:property [
        sh:path fontem:designationDate ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:message "fontem:designationDate, when present, must be xsd:date."@en ;
    ] ;

    # Legal basis — free-text. Most EU FSD rows carry the
    # regulation citation; rows that don't are real and can't
    # be reconstructed downstream, so we accept missing values.
    sh:property [
        sh:path fontem:legalBasis ;
        sh:datatype xsd:string ;
        sh:message "fontem:legalBasis must be a string when present."@en ;
    ] ;

    # Listing reason — free-text. Real EU FSD rows often omit
    # the public-facing reason; storing what we have rather than
    # rejecting the entire row is the right trade-off.
    sh:property [
        sh:path fontem:listingReason ;
        sh:datatype xsd:string ;
        sh:message "fontem:listingReason must be a string when present."@en ;
    ] ;

    # Sanction regime — controlled vocabulary; tightened in a later
    # iteration once the regime list is stable. Optional because
    # not every legacy EU FSD row carries a programme name.
    sh:property [
        sh:path fontem:sanctionRegime ;
        sh:datatype xsd:string ;
        sh:minLength 2 ;
        sh:message "fontem:sanctionRegime, when present, must be a non-trivial string."@en ;
    ] .
